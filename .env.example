PORT=8787
OPENROUTER_MODE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
SARVAM_API_KEY=
# Get from https://dashboard.sarvam.ai/key-management (standard sk_... API key, not Samvaad-only keys)
XAI_API_KEY=
OPENAI_API_KEY=
# Voice calling (India) — Exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=
EXOTEL_REGION=mumbai
PUBLIC_BASE_URL=https://voice.my-leader.in
# Legacy Twilio (US numbers / SMS verify only — not used for voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_VERIFY_SERVICE_SID=
PUBLIC_APP_URL=https://voice.my-leader.in
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local Google OAuth:
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2) Authorized JavaScript origins: http://localhost:5173
# 3) Authorized redirect URIs: http://localhost:5173/api/auth/google/callback
# 4) Paste Client ID + Client secret above, restart API
# Production: also add https://voice.my-leader.in and .../api/auth/google/callback
REQUIRE_LOGIN=

MONGODB_URI=mongodb://127.0.0.1:27017/zoco
MONGODB_DB=zoco
REDIS_URL=redis://127.0.0.1:6379
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=local007
S3_REGION=ap-south-1
S3_BUCKET=local007
ZOCO_DIAL_CONCURRENCY=4

LIVEKIT_ENABLED=true
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_AGENT_NAME=zoco-voice
LIVEKIT_BRIDGE_TOKEN=
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
ZOCO_BRIDGE_URL=http://127.0.0.1:8787
# Optional: pin LiveKit to one agent while testing
# LIVEKIT_PILOT_ONLY=true
# LIVEKIT_PILOT_AGENT_ID=agt_priya_mlc_outbound

# Pipecat Cloud (optional, parallel to LiveKit Cloud)
# Public key starts sessions: POST https://api.pipecat.daily.co/v1/public/{agent}/start
# Private key manages agents, secrets, builds, regions, and org settings
# PIPECAT_CLOUD_PUBLIC_KEY=pk_...
# PIPECAT_CLOUD_PRIVATE_KEY=
# PIPECAT_CLOUD_AGENT_NAME=zoco-voice
# Local worker fallback (only if Cloud keys are unset)
# PIPECAT_ENABLED=true
# PIPECAT_URL=http://127.0.0.1:7860
# PIPECAT_BRIDGE_TOKEN=
# PIPECAT_TRANSPORT=webrtc
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# Daily PSTN for the local worker (Cloud already includes Daily rooms)
# DAILY_API_KEY=
# PIPECAT_FROM_NUMBER=

